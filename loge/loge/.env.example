# Copie para .env e ajuste. Rode com: node --env-file=.env server.js

# Porta HTTP/WebSocket
PORT=3000

# Máximo de pessoas por sala
MAX_PEERS=8

# GIPHY (obtenha a chave no painel de desenvolvedor do GIPHY)
# Configure também esta variável nas Environment Variables do serviço de hospedagem.
# GIPHY_API_KEY=sua-chave-do-giphy

# TURN (opcional, só se amigos de fora não conseguirem conectar).
# TURN_URL aceita várias URLs separadas por vírgula.
# TURN_SECRET é o static-auth-secret do coturn.
# TURN_URL=turn:seu-servidor.exemplo.com:3478,turns:seu-servidor.exemplo.com:5349
# TURN_SECRET=troque-por-um-segredo-longo
